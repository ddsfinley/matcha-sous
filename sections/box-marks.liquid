{%- comment -%}
  The four icons printed down the side panel of the box, redrawn as line art.
  The packaging and the site make the same four promises, in the same order,
  in the same words. No body copy: the box does not explain them either.

  The icon is chosen by a block setting rather than uploaded, so a merchant
  cannot break the set by dropping in a mismatched graphic. To add a fifth
  mark, add a case below and an option to the schema.
{%- endcomment -%}

<section class="bg-plum" aria-label="{{ section.settings.aria | default: 'What Matcha Sous is for' }}">
  <div class="wrap">
    <ul class="marks">
      {%- for block in section.blocks -%}
        <li class="mark" {{ block.shopify_attributes }}>
          {%- case block.settings.icon -%}
            {%- when 'spiral' -%}
              <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><g transform="translate(-2.25 -2.25)"><path d="M42 24A18 18 0 0 1 24 39.75 15.75 15.75 0 0 1 10.5 24 13.5 13.5 0 0 1 24 12.75 11.25 11.25 0 0 1 33 24 9 9 0 0 1 24 30.75 6.75 6.75 0 0 1 20.25 24"/></g></svg>
            {%- when 'touch' -%}
              <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><g transform="translate(-1.5 -1.7)"><path d="M18.6 12.4a7.6 7.6 0 0 1 10.8 0"/><path d="M21.3 15.6a3.8 3.8 0 0 1 5.4 0"/><path d="M20.9 31.7V20.4a2.6 2.6 0 0 1 5.2 0v6.2"/><path d="M26.1 26.6a2.4 2.4 0 0 1 4.8 0v1.3a2.4 2.4 0 0 1 4.8 0v5.5c0 4.3-3.4 7.8-7.6 7.8h-2.6c-2.2 0-4.3-1-5.7-2.8l-4.1-5.2a2.5 2.5 0 0 1 .5-3.5 2.5 2.5 0 0 1 3.4.4l2.3 2.7"/></g></svg>
            {%- when 'cup' -%}
              <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><g transform="translate(0 -2.4)"><path d="M12.4 12.6h23.2l-2.4 18.6a5 5 0 0 1-5 4.4h-8.4a5 5 0 0 1-5-4.4Z"/><path d="M13.2 18.4h21.7"/><path d="M19 35.6v2.6c0 1.1.9 2 2 2h6c1.1 0 2-.9 2-2v-2.6"/></g></svg>
            {%- when 'drop' -%}
              <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><g transform="translate(0 .8)"><path d="M24 8.4c1.9 2.6 9.7 12.1 9.7 18.4a9.7 9.7 0 0 1-19.4 0c0-6.3 7.8-15.8 9.7-18.4Z"/><path d="M18.7 28.1a5.4 5.4 0 0 0 3.1 5.2"/></g></svg>
          {%- endcase -%}
          <span>{{ block.settings.line_one }}{% if block.settings.line_two != blank %}<br>{{ block.settings.line_two }}{% endif %}</span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Box marks",
  "settings": [
    { "type": "text", "id": "aria", "label": "Accessible section label", "default": "What Matcha Sous is for" }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "mark",
      "name": "Mark",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "spiral",
          "options": [
            { "value": "spiral", "label": "Spiral (smooth, uniform texture)" },
            { "value": "touch", "label": "Fingertip (one-touch operation)" },
            { "value": "cup", "label": "Cup (consistent results)" },
            { "value": "drop", "label": "Droplet (easy-clean design)" }
          ]
        },
        { "type": "text", "id": "line_one", "label": "Label, first line", "default": "Smooth," },
        { "type": "text", "id": "line_two", "label": "Label, second line", "default": "uniform texture" }
      ]
    }
  ],
  "presets": [{
    "name": "Box marks",
    "blocks": [
      { "type": "mark", "settings": { "icon": "spiral", "line_one": "Smooth,", "line_two": "uniform texture" } },
      { "type": "mark", "settings": { "icon": "touch", "line_one": "One-touch", "line_two": "operation" } },
      { "type": "mark", "settings": { "icon": "cup", "line_one": "Consistent", "line_two": "results" } },
      { "type": "mark", "settings": { "icon": "drop", "line_one": "Easy-clean", "line_two": "design" } }
    ]
  }]
}
{% endschema %}
