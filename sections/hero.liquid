{%- comment -%}
  Mirrors the hero in site/index.html: full-bleed looping video behind the
  headline. The pause button is required (WCAG 2.2.2) and is wired up by the
  script in layout/theme.liquid.
{%- endcomment -%}
<section class="hero" aria-label="Matcha Sous">
  <video class="hero-media loopvid" autoplay muted loop playsinline webkit-playsinline preload="auto" poster="{{ 'hero-bleed.webp' | asset_url }}" width="1080" height="1360" aria-label="Matcha turning in a vivid green vortex inside the Matcha Sous cup">
    <source src="{{ 'hero-vortex-v2.webm' | asset_url }}" type="video/webm">
    <source src="{{ 'hero-vortex-v2.mp4' | asset_url }}" type="video/mp4">
  </video>
  <button class="vid-toggle" type="button" aria-label="Pause video">
    <svg class="ic-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
    <svg class="ic-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" hidden><path d="M8 5v14l11-7z"/></svg>
  </button>
  <div class="wrap hero-inner">
    <h1 class="display hero-line"><span class="l1">Behind every great matcha</span><br>is a <em>Sous.</em></h1>
    <div class="cta">
      <a class="btn btn-gold btn-lg" href="#order">{{ section.settings.cta_label }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Reserve your Sous" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
