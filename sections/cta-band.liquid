{%- assign p = section.settings.product -%}
<section class="cta-band" aria-label="Buy">
  <div class="glow"></div>
  <div class="wrap inner">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="display">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.lead != blank -%}<p class="lead">{{ section.settings.lead }}</p>{%- endif -%}
    <div class="cta" style="justify-content:center">
      <a class="btn btn-gold btn-lg" href="{% if p != blank %}{{ p.url }}{% else %}#order{% endif %}">{{ section.settings.cta_label }}</a>
      {%- if section.settings.secondary_label != blank -%}
        <a class="btn btn-outline btn-lg" href="{{ section.settings.secondary_url | default: '/pages/how-it-works' }}">{{ section.settings.secondary_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Closing CTA",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "html", "id": "heading", "label": "Heading", "default": "One minute to a <em>better bowl.</em>" },
    { "type": "text", "id": "lead", "label": "Lead (blank to hide)" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Reserve your Sous" },
    { "type": "product", "id": "product", "label": "Product (blank: jump to the buy box on this page)" },
    { "type": "text", "id": "secondary_label", "label": "Second button label (blank to hide)", "default": "See how it works" },
    { "type": "url", "id": "secondary_url", "label": "Second button link (blank: How it works page)" }
  ],
  "presets": [{ "name": "Closing CTA" }]
}
{% endschema %}
