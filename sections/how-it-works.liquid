<section id="how" aria-label="How it works">
  <div class="wrap">
    <div class="split">
      <div>
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h2 class="display">{{ section.settings.heading }}</h2>
        <p class="lead">{{ section.settings.lead }}</p>
      </div>
      <div class="split-body">
        {%- for block in section.blocks -%}
          <div class="split-item" {{ block.shopify_attributes }}>
            <b>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</b>
            <div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "html", "id": "heading", "label": "Heading", "default": "Good matcha is <em>easy to lose.</em>" },
    { "type": "text", "id": "lead", "label": "Lead", "default": "Shaded for weeks, picked by hand, ground by stone. The last thirty seconds deserve the same care." }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "A vortex, not a blade" },
        { "type": "text", "id": "text", "label": "Text", "default": "A magnet turns the mixing disc beneath the cup. Nothing else touches the tea." }
      ]
    }
  ],
  "presets": [{
    "name": "How it works",
    "blocks": [
      { "type": "point", "settings": { "title": "A vortex, not a blade", "text": "A magnet turns the mixing disc beneath the cup. Nothing else touches the tea." } },
      { "type": "point", "settings": { "title": "The same agitation, every time", "text": "Calibrated speeds hold the fast, shallow motion that builds microfoam." } },
      { "type": "point", "settings": { "title": "It ends on its own", "text": "Press it and step away. Sous completes the cycle and stops." } }
    ]
  }]
}
{% endschema %}
