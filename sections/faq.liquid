<section id="qa" aria-label="Questions">
  <div class="wrap">
    <div class="head head--idx"><div class="head-body">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="display">{{ section.settings.heading }}</h2>
    </div></div>
    <div class="qa">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.q }}</summary>
          <div class="a">{{ block.settings.a }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered." }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "q", "label": "Question", "default": "How is Sous different from an electric frother?" },
        { "type": "richtext", "id": "a", "label": "Answer", "default": "<p>A frother spins a whisk head through the liquid on a shaft. Sous turns a disc magnetically from beneath a sealed stainless cup.</p>" }
      ]
    }
  ],
  "presets": [{
    "name": "FAQ",
    "blocks": [
      { "type": "qa", "settings": { "q": "How is Sous different from an electric frother?", "a": "<p>A frother spins a whisk head through the liquid on a shaft. Sous turns a disc magnetically from beneath a sealed stainless cup. The vortex mixes from the bottom up, at a calibrated speed, for a set time.</p>" } },
      { "type": "qa", "settings": { "q": "Do I need to sift my matcha?", "a": "<p>Sifting always helps. It breaks the clumps pressing forms in the tin. Sous suspends the powder either way.</p>" } },
      { "type": "qa", "settings": { "q": "Can I use any matcha?", "a": "<p>Yes. Ceremonial or culinary, any origin.</p>" } },
      { "type": "qa", "settings": { "q": "Can it make hot and iced matcha?", "a": "<p>Both. Whisk with a little water first, then pour it over hot milk or a full glass of ice.</p>" } },
      { "type": "qa", "settings": { "q": "How long does one cycle take?", "a": "<p>About thirty seconds. The timer ends it for you.</p>" } },
      { "type": "qa", "settings": { "q": "How do I clean it?", "a": "<p>Rinse the stainless cup and wipe the base with a damp cloth. Do not submerge the base.</p>" } },
      { "type": "qa", "settings": { "q": "What comes with Matcha Sous?", "a": "<p>The mixer base, the stainless matcha cup, a power adapter, a USB-C cable and the user manual.</p>" } },
      { "type": "qa", "settings": { "q": "What is the warranty?", "a": "<p>One year against manufacturing defects in materials and workmanship. We do not take returns for change of mind, so cancel before your unit ships if you are unsure.</p>" } },
      { "type": "qa", "settings": { "q": "Can I still use a bamboo chasen?", "a": "<p>Of course. Many owners do, on the mornings that allow for it. Sous is there for the ones that don't.</p>" } }
    ]
  }]
}
{% endschema %}
