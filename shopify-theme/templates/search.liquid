<section class="section bg-cream">
  <div class="container narrow">
    <div class="section-head"><span class="eyebrow">Search</span><h1 class="display">Search</h1></div>
    <form action="{{ routes.search_url }}" method="get" class="news-form" style="max-width:520px">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search the store…">
      <button class="btn btn-primary" type="submit">Search</button>
    </form>
    {%- if search.performed -%}
      <div style="margin-top:30px">
        {%- for item in search.results -%}
          <p style="padding:10px 0;border-bottom:1px solid var(--line)"><a class="link-arrow" href="{{ item.url }}">{{ item.title }}</a></p>
        {%- else -%}
          <p class="muted">No results found.</p>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
