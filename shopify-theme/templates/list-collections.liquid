<section class="section bg-cream">
  <div class="container">
    <div class="section-head"><h1 class="display">Collections</h1></div>
    <div class="feature-grid">
      {%- for collection in collections -%}
        <a class="feature" href="{{ collection.url }}"><h3 class="serif">{{ collection.title }}</h3></a>
      {%- endfor -%}
    </div>
  </div>
</section>
