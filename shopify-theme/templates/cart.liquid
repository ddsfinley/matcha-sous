<section class="section bg-cream">
  <div class="container">
    <div class="section-head"><span class="eyebrow">Your cart</span><h1 class="display">Shopping cart</h1></div>

    {%- if cart.item_count == 0 -%}
      <div class="cart-empty">
        <img class="enso" src="{{ 'logo.svg' | asset_url }}" alt="" width="64" height="64">
        <h2 class="display">Your cart is empty</h2>
        <p class="muted" style="margin:10px 0 26px">Looks like the sous chef hasn't joined your kitchen yet.</p>
        <a class="btn btn-primary btn-lg" href="/products/matcha-sous">Shop the mixer</a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate class="cart-layout">
        <div>
          <div class="cart-lines">
            {%- for item in cart.items -%}
              <div class="cart-line">
                <a class="thumb" href="{{ item.url }}"><img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.product.title | escape }}" loading="lazy"></a>
                <div class="cart-line-info">
                  <h3 class="serif">{{ item.product.title }}</h3>
                  {%- unless item.variant.title contains 'Default' -%}<p class="variant">{{ item.variant.title }}</p>{%- endunless -%}
                  <div class="qty" style="margin-top:8px">
                    <button type="button" data-qty-minus aria-label="Decrease quantity">&minus;</button>
                    <input type="number" name="updates[{{ item.key }}]" value="{{ item.quantity }}" min="0" aria-label="Quantity">
                    <button type="button" data-qty-plus aria-label="Increase quantity">+</button>
                  </div>
                  <a class="remove" href="{{ item.url_to_remove }}" style="display:inline-block;margin-top:10px">Remove</a>
                </div>
                <div class="line-right"><div class="price serif">{{ item.final_line_price | money }}</div></div>
              </div>
            {%- endfor -%}
          </div>
          <p style="margin-top:26px"><a class="link-arrow" href="/products/matcha-sous">&larr; Continue shopping</a></p>
        </div>

        <aside class="summary">
          <h2 class="serif">Order summary</h2>
          <div class="row"><span class="muted">Subtotal</span><span>{{ cart.total_price | money }}</span></div>
          <div class="row"><span class="muted">Shipping</span><span>Free</span></div>
          <div class="row"><span class="muted">Taxes</span><span>Calculated at checkout</span></div>
          <div class="row total"><span>Total</span><b class="serif">{{ cart.total_price | money }}</b></div>
          <button type="submit" name="update" class="btn btn-outline btn-block" style="margin-top:16px">Update cart</button>
          <button type="submit" name="checkout" class="btn btn-primary btn-block btn-lg" style="margin-top:10px">Checkout</button>
          <p class="muted center" style="margin-top:14px; font-size:0.8rem">Free express shipping · 30-night trial · 2-year warranty</p>
        </aside>
      </form>
    {%- endif -%}
  </div>
</section>
