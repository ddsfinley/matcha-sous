<section aria-label="Gift card">
  <div class="wrap" style="text-align:center">
    <h1 class="display">A gift card.</h1>
    <p class="lead" style="margin:16px auto 24px">{{ gift_card.balance | money }} for {{ shop.name }}.</p>
    <p class="plate" style="justify-content:center"><span><b>{{ gift_card.code | format_code }}</b></span></p>
    <p style="margin-top:26px"><a class="btn btn-primary" href="{{ shop.url }}">Shop Matcha Sous</a></p>
  </div>
</section>
