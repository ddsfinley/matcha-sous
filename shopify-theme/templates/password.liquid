<section aria-label="Opening soon">
  <div class="wrap" style="text-align:center">
    <img src="{{ 'wordmark-ink.png' | asset_url }}" alt="{{ shop.name }}" width="180" height="63" style="margin:0 auto 26px">
    <h1 class="display">Opening soon.</h1>
    <p class="lead" style="margin:16px auto 30px">{{ shop.password_message }}</p>
    {% form 'storefront_password' %}
      <div class="form" style="margin-inline:auto">
        <label for="pw">Password</label>
        <input id="pw" type="password" name="password">
        <button class="btn btn-primary" type="submit">Enter</button>
      </div>
    {% endform %}
  </div>
</section>
