{%- assign fallback = 'device-side.jpg,device-top.jpg,box.jpg,launch-guide.jpg' | split: ',' -%}
<section class="section bg-cream">
  <div class="container">
    <div class="pdp">
      <div class="gallery">
        <div class="gallery-main">
          {%- if product.images.size > 0 -%}
            <img data-gallery-main src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.featured_image.alt | escape | default: product.title }}" width="800" height="1000">
          {%- else -%}
            <img data-gallery-main src="{{ 'device-side.jpg' | asset_url }}" alt="{{ product.title }}" width="800" height="1000">
          {%- endif -%}
        </div>
        <div class="gallery-thumbs">
          {%- if product.images.size > 0 -%}
            {%- for image in product.images -%}
              <button type="button" data-gallery-thumb aria-current="{% if forloop.first %}true{% else %}false{% endif %}" data-src="{{ image | image_url: width: 1000 }}" data-alt="{{ image.alt | escape | default: product.title }}" aria-label="View image {{ forloop.index }}"><img src="{{ image | image_url: width: 300 }}" alt="" loading="lazy"></button>
            {%- endfor -%}
          {%- else -%}
            {%- for f in fallback -%}
              <button type="button" data-gallery-thumb aria-current="{% if forloop.first %}true{% else %}false{% endif %}" data-src="{{ f | asset_url }}" data-alt="{{ product.title }}" aria-label="View image {{ forloop.index }}"><img src="{{ f | asset_url }}" alt="" loading="lazy"></button>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>

      <div class="pdp-info">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a> / {{ product.title }}</nav>
        <h1 class="display">{{ product.title }}</h1>

        <div class="pdp-price">
          <span class="now serif">{{ product.price | money }}</span>
          {%- if product.compare_at_price > product.price -%}
            <span class="was">{{ product.compare_at_price | money }}</span>
            <span class="save">Save {{ product.compare_at_price | minus: product.price | money }}</span>
          {%- endif -%}
        </div>

        {%- if product.description != blank -%}
          <div class="pdp-desc rte">{{ product.description }}</div>
        {%- else -%}
          <p class="pdp-desc">Behind every great matcha. Add your powder and water, choose a preset, and step away — the contactless magnetic whisk folds air through your matcha for a perfectly smooth, foamy bowl in about twenty seconds. No chasen technique, no clumps, no wrist.</p>
        {%- endif -%}

        {%- form 'product', product, id: 'product-form' -%}
          {%- unless product.has_only_default_variant -%}
            <div class="opt-group">
              <span class="opt-label">Option</span>
              <select name="id" class="field" style="max-width:320px">
                {%- for variant in product.variants -%}
                  <option value="{{ variant.id }}"{% if variant == product.selected_or_first_available_variant %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} (sold out){% endunless %}</option>
                {%- endfor -%}
              </select>
            </div>
          {%- else -%}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          {%- endunless -%}

          <div class="qty-row">
            <span class="opt-label" style="margin:0">Qty</span>
            <div class="qty">
              <button type="button" data-qty-minus aria-label="Decrease quantity">&minus;</button>
              <input type="number" name="quantity" min="1" value="1" aria-label="Quantity">
              <button type="button" data-qty-plus aria-label="Increase quantity">+</button>
            </div>
          </div>

          <div class="pdp-actions">
            <button type="submit" name="add" class="btn btn-primary btn-lg btn-block"{% unless product.selected_or_first_available_variant.available %} disabled{% endunless %}>
              {%- if product.selected_or_first_available_variant.available -%}Add to cart — {{ product.price | money }}{%- else -%}Sold out{%- endif -%}
            </button>
          </div>
        {%- endform -%}

        <ul class="pdp-assure">
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 7h11v8H3zM14 10h4l3 3v2h-7z"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg> Free express shipping · dispatched in 1–2 business days</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3v9l5 3"/><circle cx="12" cy="12" r="9"/></svg> 30-night ritual trial — love it or return it</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3 5 6v5c0 4 3 7 7 9 4-2 7-5 7-9V6l-7-3Z"/><path d="m9 12 2 2 4-4"/></svg> Backed by a 1-year warranty</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="section bg-paper">
  <div class="container narrow">
    <div class="section-head"><span class="eyebrow">The details</span><h2 class="display">Specifications</h2></div>
    <div class="specs">
      <div class="spec"><b>Material</b><span>Food-grade stainless steel</span></div>
      <div class="spec"><b>Whisking</b><span>Contactless magnetic drive</span></div>
      <div class="spec"><b>Speeds</b><span>10 levels + 3 presets</span></div>
      <div class="spec"><b>Timer</b><span>Built-in, auto-stop</span></div>
      <div class="spec"><b>Capacity guides</b><span>40 / 80 / 120 ml etched</span></div>
      <div class="spec"><b>Power</b><span>USB-C &middot; 6W (cable included)</span></div>
      <div class="spec"><b>Finish</b><span>Matte black</span></div>
      <div class="spec"><b>Certified</b><span>FCC &middot; CE &middot; RoHS</span></div>
    </div>
  </div>
</section>
