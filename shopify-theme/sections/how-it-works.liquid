<section id="how" aria-label="How it works">
  <div class="wrap">
    <div class="split">
      <div>
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h2 class="display">{{ section.settings.heading }}</h2>
        <p class="lead">{{ section.settings.lead }}</p>
      </div>
      <div class="split-body">
        {%- for block in section.blocks -%}
          <div class="split-item" {{ block.shopify_attributes }}>
            <b>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</b>
            <div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "html", "id": "heading", "label": "Heading", "default": "Matcha doesn't dissolve. <em>It suspends.</em>" },
    { "type": "text", "id": "lead", "label": "Lead", "default": "Which is why how you move it through water matters. The difference between mixed matcha and well-made matcha is everything that happens between the first turn and the last." }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "First, suspension" },
        { "type": "text", "id": "text", "label": "Text", "default": "A fast vortex lifts the powder evenly through the water. A magnet turns the disc beneath a sealed cup, so nothing touches the tea." }
      ]
    }
  ],
  "presets": [{
    "name": "How it works",
    "blocks": [
      { "type": "point", "settings": { "title": "First, suspension", "text": "A fast vortex lifts the powder evenly through the water. A magnet turns the disc beneath a sealed cup, so nothing touches the tea." } },
      { "type": "point", "settings": { "title": "Then, refinement", "text": "The vortex slows, working the larger bubbles down into a finer, more even foam." } },
      { "type": "point", "settings": { "title": "It ends on its own", "text": "Press it and step away. Sous completes the cycle and stops." } }
    ]
  }]
}
{% endschema %}
