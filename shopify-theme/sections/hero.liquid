{%- assign p = section.settings.product -%}
<section class="hero" aria-label="{{ shop.name }}">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1 class="display">{{ section.settings.line1 }}<br>{{ section.settings.line2 }} <em>{{ section.settings.line3 }}</em></h1>
      <p class="descriptor">{{ section.settings.descriptor }}</p>
      <p class="lead">{{ section.settings.benefit }}</p>
      <div class="cta">
        <a class="btn btn-gold btn-lg" href="{% if p != blank %}{{ p.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">{{ section.settings.cta_label }}</a>
      </div>
    </div>
    <figure class="hero-shot">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1050 }}" alt="{{ section.settings.image.alt | default: shop.name }}" width="1050" height="1400" fetchpriority="high">
      {%- else -%}
        <img src="{{ 'photo-vortex.webp' | asset_url }}" alt="Matcha Sous mixing: a vivid green vortex turning in the stainless cup" width="1050" height="1400" fetchpriority="high">
      {%- endif -%}
    </figure>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "line1", "label": "Headline line 1", "default": "Behind every great matcha" },
    { "type": "text", "id": "line2", "label": "Headline line 2", "default": "is a" },
    { "type": "text", "id": "line3", "label": "Headline accent word", "default": "Sous." },
    { "type": "text", "id": "descriptor", "label": "Descriptor (blank to hide)", "default": "" },
    { "type": "text", "id": "benefit", "label": "Benefit line", "default": "Does it count as taking up counter space if you use it every day?" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Buy Matcha Sous" },
    { "type": "product", "id": "product", "label": "Product the button links to" },
    { "type": "image_picker", "id": "image", "label": "Hero image" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
