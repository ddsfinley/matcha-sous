{%- assign p = section.settings.product | default: collections.all.products.first -%}
<section id="order" aria-label="Buy">
  <div class="wrap order">
    <figure class="stage">
      <span class="media-frame">
        {%- if p != blank and p.featured_image -%}
          <img src="{{ p.featured_image | image_url: width: 900 }}" alt="{{ p.featured_image.alt | default: p.title }}" width="750" height="1000" loading="lazy">
        {%- else -%}
          <video class="loopvid" autoplay muted loop playsinline webkit-playsinline preload="auto" poster="{{ 'cycle-poster-v2.webp' | asset_url }}" width="1080" height="1440" aria-label="A full mixing cycle in the Matcha Sous cup">
            <source src="{{ 'cycle-1080-v4.webm' | asset_url }}" type="video/webm">
            <source src="{{ 'cycle-1080-v4.mp4' | asset_url }}" type="video/mp4">
          </video>
        {%- endif -%}
      </span>
      <span class="buy-thumb"><img src="{{ 'photo-case.webp' | asset_url }}" alt="The Matcha Sous presentation case" width="1320" height="667" loading="lazy"></span>
    </figure>

    <div class="buybox">
      {%- if section.settings.eyebrow != blank -%}<p class="preorder">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.variant_line != blank -%}<p class="variant">{{ section.settings.variant_line }}</p>{%- endif -%}

      {%- if p != blank -%}
        <div class="price"><b>{{ p.price | money_without_trailing_zeros }}</b></div>
      {%- else -%}
        <div class="price"><b>{{ section.settings.fallback_price }}</b></div>
      {%- endif -%}

      {%- if section.settings.closer != blank -%}
        <p class="closer">{{ section.settings.closer }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="inc">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>{{ block.settings.item }}{% if block.settings.note != blank %} <span>{{ block.settings.note }}</span>{% endif %}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if p != blank -%}
        {%- comment -%}
          name="checkout" is Shopify's standard "buy now" pattern - adds the
          item and redirects straight to checkout, skipping the cart. Works
          on every plan. Matches sections/main-product.liquid's button;
          don't let the two drift apart, since this is the same button label
          promising the same behaviour from two different entry points.
        {%- endcomment -%}
        {%- form 'product', p, id: 'buy-form' -%}
          {%- if p.variants.size > 1 -%}
            <div class="form" style="margin-bottom:18px">
              <label for="variant">Option</label>
              <select id="variant" name="id">
                {%- for v in p.variants -%}
                  <option value="{{ v.id }}"{% unless v.available %} disabled{% endunless %}>{{ v.title }} · {{ v.price | money_without_trailing_zeros }}</option>
                {%- endfor -%}
              </select>
            </div>
          {%- else -%}
            <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
          {%- endif -%}
          <button class="btn btn-primary btn-lg btn-block" type="submit" name="checkout" {% unless p.available %}disabled{% endunless %}>
            {% if p.available %}{{ section.settings.cta_label }}{% else %}Sold out{% endif %}
          </button>
        {%- endform -%}
      {%- else -%}
        <a class="btn btn-primary btn-lg btn-block" href="{{ routes.all_products_collection_url }}">{{ section.settings.cta_label }}</a>
      {%- endif -%}

      {%- if section.settings.paynote != blank -%}<p class="paynote">{{ section.settings.paynote }}</p>{%- endif -%}

      <div class="assure">
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 7h11v8H3zM14 10h4l3 3v2h-7z"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg> {{ section.settings.assure_1 }}</span>
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3 5 6v5c0 4 3 7 7 9 4-2 7-5 7-9V6l-7-3Z"/><path d="m9 12 2 2 4-4"/></svg> {{ section.settings.assure_2 }}</span>
      </div>
      {%- comment -%}
        PROP 65. A legal statement, not copy. It is a setting so a merchant can
        correct the chemical name without editing Liquid, but the default is
        the safe-harbor wording from 27 CCR 25603(a)(2) and the symbol is the
        regulation's own - do not restyle either. Blanking `p65_chemical`
        removes this link, which is the right behaviour only once someone has
        established that no warning is required - blank the matching setting
        in the Footer section too, or it will show a warning this link no
        longer points at.

        This is a LINK, not the full text. 27 CCR 25602(b) treats the internet
        warning as a distinct requirement from the on-product one - the full
        text lives once, in sections/footer.liquid, at the bottom of the page.
        The regulation's own safe harbor for splitting it this way is method
        (2): a link on the product display page, clearly marked with the word
        WARNING, pointing to the full text. That is this link. Do not delete
        it on the theory that the footer alone covers it - it does not, and
        do not let the footer's p65_chemical/p65_harm drift out of sync with
        this section's, since the link's destination has to say what the link
        promised.
      {%- endcomment -%}
      {%- if section.settings.p65_chemical != blank -%}
        <p class="p65-link">
          <a href="#prop65"><svg class="p65-mark" viewBox="0 0 24 22" role="img" aria-label="Warning symbol"><path d="M12 1.6 22.6 20H1.4Z" fill="#ffed00" stroke="#000" stroke-width="1.8" stroke-linejoin="round"/><path d="M12 7.7v6.1" stroke="#000" stroke-width="2.3" stroke-linecap="round"/><circle cx="12" cy="17.1" r="1.3"/></svg>WARNING: California Prop 65</a>
        </p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Buy box",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "fallback_price", "label": "Price if no product selected", "default": "$179" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (blank to hide)", "default": "" },
    { "type": "text", "id": "variant_line", "label": "Descriptor line (blank to hide)", "default": "" },
    { "type": "text", "id": "closer", "label": "Line above the spec list", "default": "A two-speed automatic matcha mixer designed to bring matcha and water together evenly, then change pace to refine the finish." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Reserve your Sous" },
    { "type": "text", "id": "paynote", "label": "Note under the button", "default": "Payment is collected when you reserve. Cancel any time before it ships, for a full refund." },
    { "type": "text", "id": "assure_1", "label": "Assurance 1", "default": "Free US shipping" },
    { "type": "text", "id": "assure_2", "label": "Assurance 2", "default": "One-year warranty" },
    { "type": "header", "content": "California Proposition 65" },
    { "type": "paragraph", "content": "Legally operative text. The chemical must match the supplier's Prop 65 test report, and must match the wording used on the package and on the static site. Clearing the chemical field removes the warning entirely — only do that if you have established no warning is required." },
    { "type": "text", "id": "p65_chemical", "label": "Chemical named in the warning", "default": "DEHP", "info": "Placeholder pending a test report. Leave blank to hide the warning." },
    { "type": "text", "id": "p65_harm", "label": "Harm wording", "default": "cancer and birth defects or other reproductive harm", "info": "Use exactly: 'cancer', 'birth defects or other reproductive harm', or 'cancer and birth defects or other reproductive harm'." }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Included item",
      "settings": [
        { "type": "text", "id": "item", "label": "Item", "default": "Stainless-steel mixing cup" },
        { "type": "text", "id": "note", "label": "Note", "default": "" }
      ]
    }
  ],
  "presets": [{
    "name": "Buy box",
    "blocks": [
      { "type": "item", "settings": { "item": "Stainless-steel mixing cup", "note": "" } },
      { "type": "item", "settings": { "item": "Saved settings", "note": "three" } },
      { "type": "item", "settings": { "item": "Customizable speed settings", "note": "eighteen" } },
      { "type": "item", "settings": { "item": "Etched volume guides", "note": "40 / 80 / 120 ml" } },
      { "type": "item", "settings": { "item": "Two-speed automatic cycle", "note": "" } },
      { "type": "item", "settings": { "item": "Hands-free operation", "note": "" } },
      { "type": "item", "settings": { "item": "Powered", "note": "USB-C" } },
      { "type": "item", "settings": { "item": "Hand wash only", "note": "" } }
    ]
  }]
}
{% endschema %}
