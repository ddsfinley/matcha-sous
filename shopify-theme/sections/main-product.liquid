<section class="bg-paper" aria-label="{{ product.title }}">
  <div class="wrap order">
    <figure class="stage">
      <span class="media-frame">
        {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.featured_image.alt | default: product.title }}" width="750" height="1000">
        {%- else -%}
          <img src="{{ 'cycle-poster-v2.webp' | asset_url }}" alt="{{ product.title }}" width="1080" height="1440">
        {%- endif -%}
      </span>
      {%- if product.images.size > 1 -%}
        <span class="buy-thumb"><img src="{{ product.images[1] | image_url: width: 900 }}" alt="{{ product.title }}" width="1320" height="667" loading="lazy"></span>
      {%- endif -%}
    </figure>

    <div class="buybox">
      <h2>{{ product.title }}</h2>
      {%- if product.metafields.custom.edition -%}<p class="variant">{{ product.metafields.custom.edition }}</p>{%- endif -%}
      <div class="price"><b>{{ product.price | money_without_trailing_zeros }}</b></div>

      {%- comment -%}
        RESERVE BUTTON: name="checkout" on a product form is Shopify's own
        standard "buy now" pattern - it adds the item and redirects straight
        to checkout, skipping the cart page. Works on every plan; no app or
        Shopify Plus required. Keep this name attribute - removing it silently
        turns "Reserve your Sous" back into a plain add-to-cart button that
        just sits on this page, which is the exact behaviour this was
        rewritten to fix.
      {%- endcomment -%}
      {%- form 'product', product -%}
        {%- if product.variants.size > 1 -%}
          <div class="form" style="margin-bottom:18px">
            <label for="pv">Option</label>
            <select id="pv" name="id">
              {%- for v in product.variants -%}
                <option value="{{ v.id }}"{% unless v.available %} disabled{% endunless %}>{{ v.title }} · {{ v.price | money_without_trailing_zeros }}</option>
              {%- endfor -%}
            </select>
          </div>
        {%- else -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {%- endif -%}
        <button class="btn btn-primary btn-lg btn-block" type="submit" name="checkout" {% unless product.available %}disabled{% endunless %}>
          {% if product.available %}{{ section.settings.cta_label }}{% else %}Sold out{% endif %}
        </button>
      {%- endform -%}

      {%- comment -%}
        No confirmed ship date exists anywhere in this project as of this
        section's rewrite. This setting defaults to blank on purpose - a
        placeholder date here would be a real claim shown to a paying
        customer, not a UI nicety to fill in later. Fill it in only once
        there's an actual timeframe to state; the line stays hidden until then.
      {%- endcomment -%}
      {%- if section.settings.shipping_estimate != blank -%}
        <p class="paynote">Estimated to ship {{ section.settings.shipping_estimate }}.</p>
      {%- endif -%}
      {%- if section.settings.paynote != blank -%}
        <p class="paynote">{{ section.settings.paynote }}</p>
      {%- endif -%}

      <div class="assure">
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 7h11v8H3zM14 10h4l3 3v2h-7z"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg> {{ section.settings.assure_1 }}</span>
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3 5 6v5c0 4 3 7 7 9 4-2 7-5 7-9V6l-7-3Z"/><path d="m9 12 2 2 4-4"/></svg> {{ section.settings.assure_2 }}</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Reserve your Sous" },
    { "type": "text", "id": "shipping_estimate", "label": "Estimated shipping timeframe (leave blank until confirmed)", "default": "", "info": "No ship date has been confirmed anywhere in this project yet. A placeholder here would be a real claim shown to a paying customer - leave it blank until there's an actual timeframe. The line is hidden while this is blank." },
    { "type": "text", "id": "paynote", "label": "Note under the button", "default": "Payment is collected when you reserve. Cancel any time before it ships, for a full refund." },
    { "type": "text", "id": "assure_1", "label": "Assurance 1", "default": "Free US shipping" },
    { "type": "text", "id": "assure_2", "label": "Assurance 2", "default": "One-year limited warranty" }
  ]
}
{% endschema %}
