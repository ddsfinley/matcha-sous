<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#2f3a30">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
  <link rel="apple-touch-icon" href="{{ 'favicon.svg' | asset_url }}">
  <title>{{ page_title }}{% unless page_title contains shop.name %} &middot; {{ shop.name }}{% endunless %}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
  {{ 'styles.css' | asset_url | stylesheet_tag }}

  {%- assign og_image = 'box.jpg' | asset_url | prepend: 'https:' -%}
  {%- if template contains 'product' and product.featured_image -%}{%- assign og_image = product.featured_image | image_url: width: 1200 | prepend: 'https:' -%}{%- endif -%}
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:type" content="{% if template contains 'product' %}product{% else %}website{% endif %}">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  {%- if page_description -%}<meta property="og:description" content="{{ page_description | escape }}">{%- endif -%}
  <meta property="og:image" content="{{ og_image }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ page_title | escape }}">
  {%- if page_description -%}<meta name="twitter:description" content="{{ page_description | escape }}">{%- endif -%}
  <meta name="twitter:image" content="{{ og_image }}">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      { "@type": "Organization", "name": {{ shop.name | json }}, "url": {{ shop.url | json }}, "logo": {{ 'box.jpg' | asset_url | prepend: 'https:' | json }}, "slogan": "Behind every great matcha.", "sameAs": ["https://instagram.com/matchasous", "https://tiktok.com/@matchasous", "https://youtube.com/@matchasous"] },
      { "@type": "WebSite", "name": {{ shop.name | json }}, "url": {{ shop.url | json }} }
    ]
  }
  </script>

  {{ content_for_header }}
</head>
<body>

  <div class="announce">New launch — 10% off · Free express shipping &amp; a 30-night trial · <a href="/pages/how-it-works">See how it works &rarr;</a></div>

  <header class="site-header">
    <div class="container">
      <nav class="nav" aria-label="Primary">
        <div class="nav-links left">
          <a class="nav-link" href="/products/matcha-sous">Shop</a>
          <a class="nav-link" href="/pages/how-it-works">How it works</a>
          <a class="nav-link" href="/pages/about">Our story</a>
        </div>
        <a class="brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }} — home">
          <img class="enso" src="{{ 'logo.svg' | asset_url }}" alt="" width="34" height="34">
          <span class="wordmark">Matcha Sous</span>
        </a>
        <div class="nav-links right">
          <a class="nav-link" href="/pages/faq">FAQ</a>
          <a class="nav-link" href="/pages/contact">Contact</a>
          <a class="icon-btn" href="{{ routes.cart_url }}" aria-label="View cart">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M6 7h12l-1 13H7L6 7Z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
            <span class="cart-count" data-empty="{% if cart.item_count == 0 %}true{% else %}false{% endif %}">{{ cart.item_count }}</span>
          </a>
          <button class="nav-toggle" aria-label="Open menu" aria-expanded="false"><span></span><span></span><span></span></button>
        </div>
      </nav>
    </div>
  </header>

  <div class="mobile-menu" id="mobileMenu">
    <div class="mm-top">
      <span class="wordmark">Matcha Sous</span>
      <button class="mm-close" aria-label="Close menu">&times;</button>
    </div>
    <nav aria-label="Mobile">
      <a class="mm-link" href="/products/matcha-sous">Shop</a>
      <a class="mm-link" href="/pages/how-it-works">How it works</a>
      <a class="mm-link" href="/pages/about">Our story</a>
      <a class="mm-link" href="/pages/faq">FAQ</a>
      <a class="mm-link" href="/pages/contact">Contact</a>
      <a class="mm-link" href="{{ routes.cart_url }}">Cart</a>
    </nav>
    <a class="btn btn-primary btn-block" href="/products/matcha-sous" style="margin-top:auto">Shop the mixer</a>
  </div>

  <main>{{ content_for_layout }}</main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-top">
        <div class="footer-brand">
          <a class="brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }} — home">
            <img class="enso" src="{{ 'logo.svg' | asset_url }}" alt="" width="34" height="34">
            <span class="wordmark">Matcha Sous</span>
          </a>
          <p>Behind every great matcha — the automatic, hands-free mixer for perfectly smooth bowls, every time.</p>
          <div class="footer-social">
            <a href="https://instagram.com/matchasous" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>
            <a href="https://tiktok.com/@matchasous" aria-label="TikTok"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M15 4c.5 3 2.5 4.5 5 4.7v3c-1.8 0-3.5-.6-5-1.6V15a6 6 0 1 1-6-6v3a3 3 0 1 0 3 3V4Z"/></svg></a>
            <a href="https://youtube.com/@matchasous" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="6" width="18" height="12" rx="4"/><path d="m11 9 4 3-4 3z" fill="currentColor" stroke="none"/></svg></a>
          </div>
        </div>
        <div class="footer-col">
          <h4>Shop</h4>
          <ul>
            <li><a href="/products/matcha-sous">The Mixer</a></li>
            <li><a href="/pages/how-it-works">How it works</a></li>
            <li><a href="{{ routes.cart_url }}">Your cart</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Company</h4>
          <ul>
            <li><a href="/pages/about">Our story</a></li>
            <li><a href="/pages/faq">FAQ</a></li>
            <li><a href="/pages/contact">Contact</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Support</h4>
          <ul>
            <li><a href="/pages/shipping-returns">Shipping &amp; returns</a></li>
            <li><a href="/policies/privacy-policy">Privacy policy</a></li>
            <li><a href="/policies/terms-of-service">Terms of service</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© <span data-year>{{ 'now' | date: '%Y' }}</span> {{ shop.name }}™. All rights reserved.</span>
        <span class="pays"><span>VISA</span><span>MC</span><span>AMEX</span><span>PAYPAL</span><span>APPLE PAY</span></span>
      </div>
    </div>
  </footer>

  {{ 'theme.js' | asset_url | script_tag }}
</body>
</html>
