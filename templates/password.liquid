<section class="section bg-cream center">
  <div class="container narrow">
    <img class="enso" src="{{ 'logo.svg' | asset_url }}" width="64" height="64" alt="" style="margin:0 auto 20px">
    <h1 class="display">{{ shop.name }}</h1>
    <p class="muted" style="margin:10px 0 22px">Opening soon. Enter the password to preview.</p>
    {%- form 'storefront_password' -%}
      {{ form.errors | default_errors }}
      <div class="news-form" style="max-width:380px;margin:0 auto">
        <input type="password" name="password" placeholder="Password" aria-label="Password">
        <button class="btn btn-primary" type="submit">Enter</button>
      </div>
    {%- endform -%}
  </div>
</section>
